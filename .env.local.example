# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored; never commit real secrets.

# OpenAI (chat + rolling summaries + future embeddings)
OPENAI_API_KEY=

# Optional model overrides. All have defaults chosen per call site, kept in
# src/lib/models.ts, which explains each choice. Any site can be pointed at any generation (GPT-4o, GPT-5, GPT-5.6,
# GPT-6); src/lib/model-params.ts builds the right request body for whichever
# is set.
#   INTERVIEWER_MODEL         routine interview turns      (default gpt-5.6-luna)
#   COACH_MODEL               suggested answers / rewrites (default gpt-5.6-luna)
#   ANALYZER_MODEL            per-answer scoring           (default gpt-6-luna)
#   SUMMARY_MODEL             rolling conversation summary (default gpt-6-luna)
#   JD_CLEAN_MODEL            job-posting boilerplate strip (default gpt-6-luna)
#   JUDGE_MODEL               eval judges only, never the app (default gpt-6-luna)
# After changing one, run `npm run eval:models` — one tiny request per call
# site — before any billed harness.
# INTERVIEWER_MODEL=
# COACH_MODEL=
# ANALYZER_MODEL=
# SUMMARY_MODEL=
# JD_CLEAN_MODEL=
# JUDGE_MODEL=

# Azure Speech (server-only; the client never sees the raw key — it's
# proxied through /api/speech-token).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Use whichever key your Supabase dashboard shows you. The legacy `anon`
# JWT and the newer `sb_publishable_*` key both work — set just one.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key — server-only, never exposed to the browser. Only
# required for admin tasks; the app itself uses the anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional latency budgets for an interview turn, in milliseconds. The defaults
# are the tested values; change them only to experiment.
#   STEER_DEADLINE_MS      wait for the scorer before the next question (4000)
#   RETRIEVAL_DEADLINE_MS  wait for job-description retrieval (3000)
#   PERSIST_DEADLINE_MS    wait for a late score after the reply (3000)
# STEER_DEADLINE_MS=
# RETRIEVAL_DEADLINE_MS=
# PERSIST_DEADLINE_MS=

# Dev server only: extra addresses allowed to open `npm run dev` / `dev:https`,
# comma-separated, when testing from another device. Example: 192.168.1.42
# NEXT_DEV_ORIGINS=

# Demo account for `npm run seed:demo` (optional).
# DEMO_EMAIL=demo@convotrainer.dev
# DEMO_PASSWORD=
